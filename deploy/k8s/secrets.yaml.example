# =============================================================================
# Evolith Kubernetes Deployment - Secrets Template
# =============================================================================
# Copy this file to secrets.yaml and fill in real values:
#   cp secrets.yaml.example secrets.yaml
#   kubectl create secret generic evolith-secrets \
#     --from-literal=postgres-password=<value> \
#     --from-literal=redis-password=<value> \
#     --from-literal=jwt-secret=<value> \
#     --from-literal=stripe-secret-key=<value> \
#     --from-literal=stripe-webhook-secret=<value> \
#     --from-literal=smtp-password=<value> \
#     -n evolith --dry-run=client -o yaml > secrets.yaml
# =============================================================================
# Or use envsubst to generate from environment:
#   envsubst < secrets.yaml.example | kubectl apply -f -
# =============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: evolith-secrets
  namespace: evolith
  labels:
    app.kubernetes.io/part-of: evolith
type: Opaque
stringData:
  postgres-password: "CHANGE_ME_IN_PRODUCTION"
  redis-password: "CHANGE_ME_IN_PRODUCTION"
  jwt-secret: "CHANGE_ME_IN_PRODUCTION"
  # Stripe (leave placeholder if unused)
  stripe-secret-key: "sk_test_placeholder"
  stripe-webhook-secret: "whsec_placeholder"
  # SMTP (leave empty if disabled)
  smtp-password: ""
