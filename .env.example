# ===========================================
# Evolith Development Environment
# ===========================================

# Server Configuration
APP__PUBLIC_URL=http://localhost:3001
APP__API_BASE_URL=/api/v1
SERVER__HOST=0.0.0.0
SERVER__PORT=8080

# Frontend Configuration
VITE_API_URL=http://localhost:8080/api/v1

# Database Configuration (SQLite for development)
DATABASE__DATABASE_TYPE=sqlite
DATABASE__URL=:memory:
# Or use file-based SQLite:
# DATABASE__URL=sqlite:dev.db?mode=rwc

# Database Configuration (PostgreSQL - when using docker-compose)
# DATABASE__DATABASE_TYPE=postgres
# DATABASE__URL=postgres://evolith:dev_password@localhost:5432/evolith

DATABASE__MAX_CONNECTIONS=10
DATABASE__SEED_DATABASE=true

# Redis Configuration
REDIS__URL=redis://localhost:6379

# JWT Configuration
JWT__SECRET=dev_secret_key_change_in_production
JWT__EXPIRATION=24h

# Storage Configuration (MinIO)
STORAGE__ENDPOINT=localhost:9000
STORAGE__ACCESS_KEY=minioadmin
STORAGE__SECRET_KEY=minioadmin
STORAGE__USE_SSL=false
STORAGE__BUCKET=evolith

# Sandbox Configuration
SANDBOX__ENABLED=true
SANDBOX__TIMEOUT_SECONDS=30
SANDBOX__MEMORY_MB=256
SANDBOX__CPU_SHARES=512
SANDBOX__PIDS_LIMIT=256
SANDBOX__NETWORK_ENABLED=false
SANDBOX__MAX_OUTPUT_BYTES=10485760

# SMTP Configuration
# For dev: use MailHog (port 1025) or disable (SMTP__ENABLED=false → ConsoleMailer)
# For prod: configure real SMTP server
SMTP__HOST=localhost
SMTP__PORT=1025
SMTP__USERNAME=
SMTP__PASSWORD=
SMTP__FROM_ADDRESS=noreply@evolith.io
SMTP__FROM_NAME=Evolith
SMTP__ENABLED=false

# Rate Limiting (requests per minute)
RATE_LIMIT__UNAUTHENTICATED_RPM=30
RATE_LIMIT__AUTHENTICATED_RPM=300
RATE_LIMIT__API_KEY_RPM=1000

# Stripe Configuration
STRIPE__SECRET_KEY=sk_test_placeholder
STRIPE__WEBHOOK_SECRET=whsec_placeholder
STRIPE__TEST_MODE=true

# Logging
LOG__LEVEL=debug

# Environment
ENVIRONMENT=development
